DL_HIDDEN = ""
DL_BANNER = "### 馃帀 鎶ュ憡宸茬敓鎴愶紒璇风偣鍑讳笅鏂规枃浠朵笅杞?鈫撯啌鈫?"


# 鈽?v7: 宸ュ叿鍚嶆槧灏勶紙v7.13 澧炲姞 form_fill锛?
TOOL_NAMES = {
    "read_files": "馃搨 璇诲彇鏂囦欢",
    "classify_documents": "馃彿锔?鍒嗙被鏂囦欢",
    "extract_financial_data": "馃搳 鎻愬彇璐㈠姟",
    "audit_materials": "馃搵 鐩樼偣鏉愭枡",
    "search_web": "馃攳 缃戠粶鎼滅储",
    "write_chapter": "鉁嶏笍 鎾板啓绔犺妭",
    "write_all_chapters": "鉁嶏笍 鎾板啓鍏ㄩ儴绔犺妭",
    "self_reflect": "馃 鑷渷瀹¤",
    "review_report": "馃攳 瀹℃煡鎶ュ憡",
    "revise_chapter": "馃敡 淇敼绔犺妭",
    "export_to_word": "馃搫 瀵煎嚭 Word",
    "ask_user": "馃挰 璇锋眰纭",
    "form_fill": "馃摑 濉啓鐢虫姤琛?",  # 鈽?v7.13
}


def stream_chat(text, files, chatbot, api_key, provider, session_state, mode_state):
    """娴佸紡鑱婂ぉ澶勭悊"""
    chatbot = chatbot or []
    _pending_md = gr.update()   # default: no change to pending panel

    def out(cb, txt="", banner=None, dl=None, exp=None, status="",
            ptags_md=None):
        return (
            cb,
            txt,
            gr.update(),          # file_upload: 涓嶆竻绌猴紝閬垮厤鐢ㄦ埛閲嶆柊涓婁紶
            gr.update(value=banner) if banner is not None else gr.update(),
            gr.update(value=dl, visible=True) if dl else gr.update(),
            gr.update(visible=True) if exp else (gr.update(visible=False) if exp is False else gr.update()),
            status,
            gr.update(value=ptags_md) if ptags_md is not None else gr.update(),
        )

    if not api_key or not api_key.strip():
        chatbot.append({"role": "assistant", "content": "鈿狅笍 璇峰厛鍦ㄥ乏渚у～鍐?API 瀵嗛挜銆?})
        yield out(chatbot, status="鈿狅笍 璇峰～鍐?API 瀵嗛挜")
        return

    user_text = text or ""
    file_paths = []
    if files:
        for f in files:
            if isinstance(f, str):
                file_paths.append(f)
            elif hasattr(f, "name"):
                file_paths.append(f.name)

    if not user_text and not file_paths:
        chatbot.append({"role": "assistant", "content": "璇疯緭鍏ユ秷鎭垨涓婁紶鏂囦欢 馃槉"})
        yield out(chatbot, status="绛夊緟杈撳叆")
        return

    user_display = user_text
    if file_paths:
        fnames = [p.rsplit("/", 1)[-1].rsplit("\\", 1)[-1] for p in file_paths]
        user_display += f"\n馃搸 闄勪欢: {', '.join(fnames)}"

    chatbot.append({"role": "user", "content": user_display})
    yield out(chatbot, status="馃攧 Agent 鍚姩涓?..")

    sid = session_state or "default"
    agent = get_agent(sid, api_key, provider)

    # 鈽?v7.13: 鍚屾妯″紡鍒?Agent
    current_mode = mode_state or "鍙欒堪鎶ュ憡"
    agent.mode = "form_fill" if "濉┖" in current_mode else "narrative"

    start_time = time.time()
    thinking_parts = []
    full_response = ""
    pending_file = None

    for event in agent.process_message(user_text, file_paths or None):
        elapsed = time.time() - start_time
        evt_type = event.get("type", "")

        if evt_type == "thinking":
            thinking_parts.append(f"馃攧 {event['content']}")
            msg = "\n".join(thinking_parts)
            temp = chatbot + [{"role": "assistant", "content": msg}]
            yield out(temp, status=f"馃攧 {event['content']} ({elapsed:.0f}绉?")

        elif evt_type == "tool_call":
            name = event["name"]
            dn = TOOL_NAMES.get(name, f"馃敡 {name}")
            if event.get("status") == "skipped":
                thinking_parts.append(f"鈴笍 {dn}锛堝凡缂撳瓨锛?)
            else:
                thinking_parts.append(f"鈴?{dn}...")
            msg = "\n".join(thinking_parts)
            temp = chatbot + [{"role": "assistant", "content": msg}]
            yield out(temp, status=f"{dn} ({elapsed:.0f}绉?")

        elif evt_type == "tool_result":
            name = event["name"]
            dn = TOOL_NAMES.get(name, f"馃敡 {name}")
            thinking_parts.append(f"鉁?{dn}")
            msg = "\n".join(thinking_parts)
            temp = chatbot + [{"role": "assistant", "content": msg}]
            yield out(temp, status=f"鉁?{dn} ({elapsed:.0f}绉?")

        elif evt_type == "message":
            full_response = event["content"]
            msg = "\n".join(thinking_parts)
            if msg:
                msg += "\n\n---\n\n"
            msg += full_response
            temp = chatbot + [{"role": "assistant", "content": msg}]
            yield out(temp, status=f"馃挰 鍥炲涓?.. ({elapsed:.0f}绉?")

        elif evt_type == "file":
            pending_file = event["path"]
            fname = os.path.basename(pending_file)
            thinking_parts.append(f"\n馃帀馃帀馃帀 *鎶ュ憡宸茬敓鎴? {fname}*\n馃摜 璇峰湪鑱婂ぉ鍖轰笂鏂逛笅杞?)
            msg = "\n".join(thinking_parts)
            temp = chatbot + [{"role": "assistant", "content": msg}]
            yield out(temp, banner=DL_BANNER, dl=pending_file, exp=False,
                      status=f"馃帀 鎶ュ憡灏辩华锛?{elapsed:.0f}绉?")

        elif evt_type == "export_error":
            err = event.get("content", "鏈煡閿欒")
            thinking_parts.append(f"鈿狅笍 鑷姩瀵煎嚭澶辫触: {err}\n馃憠 鍙偣鍑汇€屾墜鍔ㄥ鍑恒€嶆寜閽?)
            msg = "\n".join(thinking_parts)
            temp = chatbot + [{"role": "assistant", "content": msg}]
            yield out(temp, exp=True, status=f"鈿狅笍 瀵煎嚭澶辫触 ({elapsed:.0f}绉?")

        elif evt_type == "pending_tags":
            tags = event.get("tags", [])
            if tags:
                # Group by category
                by_cat = {}
                for t in tags:
                    cat = t.get("category", "馃煛 鍙兘鍦ㄦ潗鏂欎腑")
                    by_cat.setdefault(cat, []).append(t)

                lines = [f"**鍏?{len(tags)} 澶勫緟瀹屽杽**\n"]
                for cat, cat_tags in sorted(by_cat.items()):
                    lines.append(f"\n**{cat}**")
                    for t in cat_tags[:20]:
                        lines.append(f"- {t['label'][:45]}")
                    if len(cat_tags) > 20:
                        lines.append(f"- *...杩樻湁{len(cat_tags)-20}椤?")
                _pending_md = "\n".join(lines)
                # 鈽?v7.14: 鍙洿鏂?pending_tags_display Markdown锛屼笉鏇存柊 accordion
                msg = "\n".join(thinking_parts)
                temp = chatbot + [{"role": "assistant", "content": msg}]
                yield out(temp, status=f"馃搵 寰呰ˉ鍏呮竻鍗曞凡鏇存柊",
                          ptags_md=_pending_md)

        elif evt_type == "done":
            pass

    # 鏈€缁堣緭鍑?    elapsed = time.time() - start_time
    if full_response:
        final = ("\n".join(thinking_parts) + "\n\n---\n\n" + full_response) if thinking_parts else full_response
    elif thinking_parts:
        final = "\n".join(thinking_parts)
    else:
        final = "锛堝鐞嗗畬鎴愶級"

    chatbot.append({"role": "assistant", "content": final})

    if pending_file:
        yield out(chatbot, banner=DL_BANNER, dl=pending_file, exp=False,
                  status=f"鉁?瀹屾垚锛佽鍦ㄤ笂鏂逛笅杞?({elapsed:.0f}绉?",
                  ptags_md=_pending_md if isinstance(_pending_md, str) else None)
    else:
        show_export = False
        if sid in agents:
            ag = agents[sid]
            has = any(ag.chapters.get(f"ch{i}") for i in range(1, 5))
            if has and not ag.report_exported:
                show_export = True
        yield out(chatbot, exp=show_export if show_export else False,
                  status=f"鉁?瀹屾垚 ({elapsed:.0f}绉?",
                  ptags_md=_pending_md if isinstance(_pending_md, str) else None)


def on_manual_export(session_state):
    """鎵嬪姩瀵煎嚭鎸夐挳"""
    sid = session_state or "default"
    if sid not in agents:
        return gr.update(), gr.update(), gr.update(), "鈿狅笍 娌℃湁娲昏穬鐨?Agent"

    agent = agents[sid]
    if not any(agent.chapters.get(f"ch{i}") for i in range(1, 5)):
        return gr.update(), gr.update(), gr.update(), "鈿狅笍 杩樻病鏈夊啓濂界殑绔犺妭"

    try:
        if agent.template_path:
            from word_export import make_word_from_template
            path = make_word_from_template(
                agent.template_path, agent.chapters,
                client_name=agent._guess_client_name(),
            )
        else:
            from word_export import make_word_report
            path = make_word_report(
                agent._guess_client_name(), "", "", "", "", "",
                agent.chapters,
            )
        agent.report_exported = True
        return (gr.update(value=DL_BANNER),
                gr.update(value=path, visible=True),
                gr.update(visible=False),
                "鉁?瀵煎嚭鎴愬姛锛佽涓嬭浇")
    except Exception as e:
        return (gr.update(),
                gr.update(),
                gr.update(visible=True),
                f"鉂?瀵煎嚭澶辫触: {e}")


def on_template_upload(template_file, session_state, mode_state):
    """妯＄増涓婁紶澶勭悊 鈥?鏍规嵁妯″紡鍐冲畾鐢ㄩ€?""
    if template_file is None:
        return "鏈娴嬪埌妯＄増鏂囦欢"
    sid = session_state or "default"
    path = template_file.name if hasattr(template_file, "name") else str(template_file)

    # 鎸佷箙鍖栨ā鐗?    import shutil
    persist_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "templates_cache")
    os.makedirs(persist_dir, exist_ok=True)
    basename = os.path.basename(path)
    persist_path = os.path.join(persist_dir, basename)
    try:
        shutil.copy2(path, persist_path)
        path = persist_path
    except Exception:
        pass

    current_mode = mode_state or "鍙欒堪鎶ュ憡"
    is_form_fill = "濉┖" in current_mode

    if sid not in agents:
        if is_form_fill:
            _pending_form_templates[sid] = path
        else:
            _pending_templates[sid] = path
        return f"鉁?宸叉殏瀛樻ā鐗堬紙鍙戦€佹秷鎭悗鑷姩鍔犺浇锛? {basename}"

    agent = agents[sid]

    if is_form_fill:
        # 鈽?v7.13: 濉┖妯″紡 鈥?璁剧疆 form_template_path
        agent.form_template_path = path
        agent.form_fill_done = False
        agent.form_fill_output = ""
        return f"鉁?濉┖妯＄増宸插姞杞? {basename}\n馃摑 璇蜂笂浼犳潗鏂欐枃浠跺悗鍙戦€併€屽紑濮嬪～鍐欍€?
    else:
        # 鍙欒堪妯″紡 鈥?鍘熼€昏緫
        old_template = agent.template_path
        agent.set_template(path)
        has_old_chapters = any(agent.chapters.get(f"ch{i}") for i in range(1, 5))
        if has_old_chapters:
            agent.chapters.clear()
            agent.report_exported = False
            agent.report_reviewed = False
            agent.self_reflected = False
            return f"鉁?妯＄増宸叉洿鎹? {basename}\n馃摑 宸叉竻闄ゆ棫鎶ュ憡缂撳瓨锛屼笅娆＄敓鎴愬皢浣跨敤鏂版ā鐗?
        return f"鉁?宸插姞杞芥ā鐗? {basename}"


def on_mode_change(mode_choice):
    """鈽?v7.13: 妯″紡鍒囨崲 鈥?鏇存柊娆㈣繋璇拰妯＄増鎻愮ず"""
    if "濉┖" in mode_choice:
        welcome = WELCOME_FORM_FILL
        tpl_label = "涓婁紶濉┖妯＄増锛?docx锛屽繀濉級"
    else:
        welcome = WELCOME_NARRATIVE
        tpl_label = "涓婁紶 Word 妯＄増锛堝彲閫夛級"
    return (
        [{"role": "assistant", "content": welcome}],  # chatbot
        gr.update(label=tpl_label),                    # template_upload label
        mode_choice,                                   # mode_state
    )


def on_feedback(feedback_text, session_state):
    if not feedback_text or not feedback_text.strip():
        return ""
    sid = session_state or "default"
    if sid in agents:
        agents[sid].memory.knowledge.add_preference("user_feedback", feedback_text.strip())
        return "鉁?鍙嶉宸茶褰?
    return "鈿狅笍 璇峰厛鍚姩 Agent"


def build_app():
    with gr.Blocks(title="淇¤捶鎶ュ憡Agent v7.22", css=CSS, theme=gr.themes.Soft()) as app:
        session_state = gr.State("default")
        mode_state = gr.State("鍙欒堪鎶ュ憡")  # 鈽?v7.13

        gr.Markdown(
            "# 馃搳 淇¤捶鎶ュ憡Agent v7.22\n"
            "> 鍙欒堪鎶ュ憡 路 濉┖鐢虫姤琛?路 妯＄増娣卞害鍙傝€?路 璐ㄩ噺闂ㄦ帶 路 .doc/.pdf鏀寔",
            elem_id="header",
        )

        with gr.Row():
            # ===== 宸︿晶閰嶇疆闈㈡澘 =====
            with gr.Column(scale=1, min_width=280):
                with gr.Accordion("鈿欙笍 閰嶇疆", open=True):
                    api_key_input = gr.Textbox(
                        label="API 瀵嗛挜",
                        placeholder="sk-xxx",
                        type="password",
                    )
                    provider_select = gr.Dropdown(
                        label="妯″瀷",
                        choices=["deepseek", "kimi-k2.5", "openai", "claude"],
                        value="deepseek",
                    )
                    # 鈽?v7.13: 妯″紡閫夋嫨鍣?                    mode_select = gr.Radio(
                        label="馃搶 宸ヤ綔妯″紡",
                        choices=["鍙欒堪鎶ュ憡", "濉┖鐢虫姤琛?],
                        value="鍙欒堪鎶ュ憡",
                    )

                with gr.Accordion("馃搵 妯＄増", open=True):
                    template_upload = gr.File(
                        label="涓婁紶 Word 妯＄増锛堝彲閫夛級",
                        file_types=[".docx", ".doc"],
                    )
                    template_status = gr.Markdown("")

                # 鈽?v7.13: 寰呰ˉ鍏呮爣绛鹃潰鏉匡紙濮嬬粓鍙涓旈粯璁ゅ睍寮€锛岀‘淇濆唴瀹规洿鏂版椂绔嬪嵆鍙锛?                with gr.Accordion("馃搵 寰呰ˉ鍏呭瓧娈?, open=True, visible=True) as pending_accordion:
                    pending_tags_display = gr.Markdown(
                        value="*濉啓瀹屾垚鍚庯紝寰呰ˉ鍏呭瓧娈靛垪琛ㄥ皢鏄剧ず鍦ㄦ澶?",
                        elem_id="pending-tags",
                    )

                with gr.Accordion("馃挕 鍙嶉", open=False):
                    feedback_input = gr.Textbox(
                        label="鏀硅繘寤鸿",
                        placeholder="鍛婅瘔鎴戝摢閲岄渶瑕佹敼杩?..",
                        lines=2,
                    )
                    feedback_btn = gr.Button("鎻愪氦", variant="secondary", size="sm")
                    feedback_result = gr.Markdown("")

                status_display = gr.Textbox(
                    label="馃搳 鐘舵€?,
                    value="绛夊緟杈撳叆",
                    interactive=False,
                    max_lines=2,
                )

            # ===== 鍙充晶鑱婂ぉ鍖?=====
            with gr.Column(scale=3):
                dl_banner = gr.Markdown(
                    value="",
                    elem_classes=["download-banner"],
                )
                dl_file = gr.File(
                    label="馃摜 鐐瑰嚮涓嬭浇鎶ュ憡",
                    visible=False,
                )
                manual_export_btn = gr.Button(
                    "馃搫 鎵嬪姩瀵煎嚭 Word 鎶ュ憡",
                    variant="primary",
                    visible=False,
                )

                chatbot = gr.Chatbot(
                    value=[{"role": "assistant", "content": WELCOME_NARRATIVE}],
                    height=480,
                    elem_classes=["chatbot-container"],
                )

                with gr.Row():
                    chat_input = gr.Textbox(
                        placeholder="杈撳叆娑堟伅锛屾寜鍥炶溅鍙戦€?..",
                        show_label=False,
                        scale=3,
                        container=False,
                    )
                    file_upload = gr.File(
                        label="馃搸 涓婁紶鏉愭枡鏂囦欢",
                        file_types=[".txt", ".docx", ".doc", ".pdf", ".xlsx", ".xls"],
                        file_count="multiple",
                        scale=2,
                        min_width=200,
                    )
                    send_btn = gr.Button("鍙戦€?, variant="primary", scale=0, min_width=80)

        # ===== 浜嬩欢缁戝畾 =====
        # 鈽?v7.13: stream_chat 澧炲姞 mode_state 杈撳叆
        send_inputs = [chat_input, file_upload, chatbot, api_key_input,
                       provider_select, session_state, mode_state]
        # 鈽?v7.14: 鍘绘帀 pending_accordion锛屽彧鏇存柊鍐呴儴 Markdown 鍐呭
        # 锛圓ccordion 宸查潤鎬?visible=True锛屾棤闇€鍔ㄦ€佹帶鍒讹紝閬垮厤 Gradio 6.x 閲嶇粯 bug锛?        send_outputs = [chatbot, chat_input, file_upload,
                        dl_banner, dl_file, manual_export_btn, status_display,
                        pending_tags_display]

        send_btn.click(fn=stream_chat, inputs=send_inputs, outputs=send_outputs)
        chat_input.submit(fn=stream_chat, inputs=send_inputs, outputs=send_outputs)

        manual_export_btn.click(
            fn=on_manual_export,
            inputs=[session_state],
            outputs=[dl_banner, dl_file, manual_export_btn, status_display],
        )

        # 鈽?v7.13: 妯＄増涓婁紶涔熶紶鍏?mode_state
        template_upload.change(
            fn=on_template_upload,
            inputs=[template_upload, session_state, mode_state],
            outputs=[template_status],
        )

        # 鈽?v7.13: 妯″紡鍒囨崲浜嬩欢
        mode_select.change(
            fn=on_mode_change,
            inputs=[mode_select],
            outputs=[chatbot, template_upload, mode_state],
        )

        feedback_btn.click(
            fn=on_feedback,
            inputs=[feedback_input, session_state],
            outputs=[feedback_result],
        )

    return app


if __name__ == "__main__":
    app = build_app()
    app.launch(share=True, server_name="0.0.0.0", server_port=7860)

