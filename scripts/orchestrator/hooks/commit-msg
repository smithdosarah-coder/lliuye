#!/usr/bin/env bash
# git commit-msg hook: validate Signal trailer via orchestrator/validator.py
#
# Wired in by scripts/orchestrator/hooks/install.sh, which sets
#   git config core.hooksPath scripts/orchestrator/hooks
# git invokes this with the path to .git/COMMIT_EDITMSG as $1.
set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
# Normalise to forward slashes so it works under Git Bash on Windows.
PROJECT_ROOT="${PROJECT_ROOT//\\//}"

VALIDATOR="${PROJECT_ROOT}/scripts/orchestrator/validator.py"

# Prefer the Windows `py` launcher (project standard); fall back to python3/python.
if command -v py >/dev/null 2>&1; then
    PY=py
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=python
fi

exec "$PY" "$VALIDATOR" "$1"
