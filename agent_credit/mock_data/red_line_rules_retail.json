{
  "segment": "retail",
  "rules": [
    {
      "id": "retail_rl_001",
      "name": "征信严重逾期",
      "category": "credit",
      "feature_expr": "credit.overdue_severity",
      "operator": ">=",
      "default_threshold": 3,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "近 24 个月存在 M3 及以上逾期记录"
    },
    {
      "id": "retail_rl_002",
      "name": "征信查询次数过多",
      "category": "credit",
      "feature_expr": "credit.query_count_24m",
      "operator": ">",
      "default_threshold": 10,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["说明短期内多次查询原因"],
      "description": "近 24 个月征信查询次数超过 10 次"
    },
    {
      "id": "retail_rl_003",
      "name": "信用卡利用率过高",
      "category": "credit",
      "feature_expr": "credit.card_utilization",
      "operator": ">",
      "default_threshold": 0.90,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["核实近月还款能力"],
      "description": "信用卡综合利用率超过 90%"
    },
    {
      "id": "retail_rl_004",
      "name": "当前贷款笔数过多",
      "category": "credit",
      "feature_expr": "credit.current_loans_count",
      "operator": ">",
      "default_threshold": 5,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["核实还款能力"],
      "description": "当前在贷笔数超过 5 笔"
    },
    {
      "id": "retail_rl_005",
      "name": "对外担保笔数过多",
      "category": "credit",
      "feature_expr": "credit.guarantee_count",
      "operator": ">",
      "default_threshold": 2,
      "severity": "low",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["披露被担保人资质"],
      "description": "对外担保超过 2 笔"
    },
    {
      "id": "retail_rl_006",
      "name": "征信历史过短",
      "category": "credit",
      "feature_expr": "credit.account_age_years",
      "operator": "<",
      "default_threshold": 2,
      "severity": "low",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["补充收入证明"],
      "description": "征信账龄不足 2 年"
    },
    {
      "id": "retail_rl_007",
      "name": "月收入过低",
      "category": "capacity",
      "feature_expr": "capacity.monthly_income",
      "operator": "<",
      "default_threshold": 5000,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "月收入低于 5000 元"
    },
    {
      "id": "retail_rl_008",
      "name": "债务收入比过高",
      "category": "capacity",
      "feature_expr": "capacity.dti_ratio",
      "operator": ">",
      "default_threshold": 0.70,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "预计债务收入比超过 70%"
    },
    {
      "id": "retail_rl_009",
      "name": "月收入不稳定且无抵押",
      "category": "capacity",
      "feature_expr": "capacity.unstable_and_no_collateral",
      "operator": "==",
      "default_threshold": 1,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["追加共同借款人"],
      "description": "收入波动或季节性且无抵押物"
    },
    {
      "id": "retail_rl_010",
      "name": "银行流水平均余额过低",
      "category": "capacity",
      "feature_expr": "capacity.avg_balance_6m",
      "operator": "<",
      "default_threshold": 2000,
      "severity": "low",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["补充其他资产证明"],
      "description": "近 6 个月平均余额低于 2000 元"
    },
    {
      "id": "retail_rl_011",
      "name": "社保公积金断缴",
      "category": "stability",
      "feature_expr": "stability.social_security_months",
      "operator": "<",
      "default_threshold": 6,
      "severity": "low",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["自雇人员可用纳税记录替代"],
      "description": "社保公积金连续缴纳少于 6 个月"
    },
    {
      "id": "retail_rl_012",
      "name": "当前岗位年限过短",
      "category": "stability",
      "feature_expr": "stability.years_in_job",
      "operator": "<",
      "default_threshold": 1,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["提供前一份工作证明"],
      "description": "当前岗位任职不足 1 年"
    },
    {
      "id": "retail_rl_013",
      "name": "居住年限过短",
      "category": "stability",
      "feature_expr": "stability.years_at_address",
      "operator": "<",
      "default_threshold": 1,
      "severity": "low",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["提供居住证明"],
      "description": "当前居住地址年限不足 1 年"
    },
    {
      "id": "retail_rl_014",
      "name": "年龄超出可贷范围",
      "category": "stability",
      "feature_expr": "stability.age_out_of_range",
      "operator": "==",
      "default_threshold": 1,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "年龄不在 22-65 岁放贷区间"
    },
    {
      "id": "retail_rl_015",
      "name": "LTV 过高",
      "category": "collateral",
      "feature_expr": "collateral.ltv",
      "operator": ">",
      "default_threshold": 0.70,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["降低申请额度"],
      "description": "抵押贷款价值比超过 70%"
    },
    {
      "id": "retail_rl_016",
      "name": "抵押物重复抵押",
      "category": "collateral",
      "feature_expr": "collateral.mortgage_count",
      "operator": ">=",
      "default_threshold": 2,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["确认顺位及他项权利"],
      "description": "抵押物已存在 2 次以上抵押"
    },
    {
      "id": "retail_rl_017",
      "name": "抵押物产权未核验",
      "category": "collateral",
      "feature_expr": "collateral.title_verified",
      "operator": "==",
      "default_threshold": 0,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "抵押物产权证未核验"
    },
    {
      "id": "retail_rl_018",
      "name": "贷款用途不符合普惠金融",
      "category": "compliance",
      "feature_expr": "compliance.purpose_blacklist",
      "operator": "==",
      "default_threshold": 1,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "贷款用途涉及证券、房地产炒作等禁止领域"
    },
    {
      "id": "retail_rl_019",
      "name": "申请额度超出档位上限",
      "category": "compliance",
      "feature_expr": "compliance.amount_over_tier",
      "operator": "==",
      "default_threshold": 1,
      "severity": "medium",
      "is_hard": false,
      "can_waive": true,
      "waiver_conditions": ["降低申请额度至档位上限"],
      "description": "申请额度超过当前评分档位允许的上限"
    },
    {
      "id": "retail_rl_020",
      "name": "反欺诈命中",
      "category": "compliance",
      "feature_expr": "compliance.fraud_flag",
      "operator": "==",
      "default_threshold": 1,
      "severity": "high",
      "is_hard": true,
      "can_waive": false,
      "waiver_conditions": [],
      "description": "触发反欺诈规则（设备/身份/地址异常）"
    }
  ]
}
