{
  "segment": "corporate",
  "rules": [
    {
      "id": "corp_rl_001",
      "name": "关联交易占比过高",
      "category": "financial",
      "feature_expr": "external.related_party_pct",
      "operator": ">",
      "default_threshold": 0.3,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供关联交易审计说明",
        "设置单一客户额度上限"
      ],
      "description": "关联交易占总营收比例超过 30%，存在利益输送风险"
    },
    {
      "id": "corp_rl_002",
      "name": "应收账款周转过长",
      "category": "financial",
      "feature_expr": "financial.ar_turnover_days",
      "operator": ">",
      "default_threshold": 120,
      "severity": "green",
      "can_waive": true,
      "waiver_conditions": [
        "季度提交应收账款账龄表",
        "单笔应收账款超过 180 天触发预警"
      ],
      "description": "应收账款周转天数超过 120 天，资金占用严重"
    },
    {
      "id": "corp_rl_003",
      "name": "资产负债率过高",
      "category": "financial",
      "feature_expr": "financial.debt_ratio",
      "operator": ">",
      "default_threshold": 0.75,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "资产负债率超过 75%，偿债能力严重不足"
    },
    {
      "id": "corp_rl_004",
      "name": "净利润连续两年亏损",
      "category": "financial",
      "feature_expr": "financial.consecutive_loss_years",
      "operator": ">=",
      "default_threshold": 2,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "连续两年净利润为负，持续经营能力存疑"
    },
    {
      "id": "corp_rl_005",
      "name": "经营性现金流净额为负",
      "category": "financial",
      "feature_expr": "financial.operating_cash_flow",
      "operator": "<",
      "default_threshold": 0,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供未来 12 个月现金流预测",
        "追加担保"
      ],
      "description": "经营活动现金流净额为负，造血能力不足"
    },
    {
      "id": "corp_rl_006",
      "name": "单笔贷款对净资产比例过高",
      "category": "financial",
      "feature_expr": "financial.request_to_netasset",
      "operator": ">",
      "default_threshold": 0.5,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "追加抵押物或担保人"
      ],
      "description": "本次申请额度超过净资产 50%，杠杆风险偏高"
    },
    {
      "id": "corp_rl_007",
      "name": "流动比率过低",
      "category": "financial",
      "feature_expr": "financial.current_ratio",
      "operator": "<",
      "default_threshold": 1.0,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "说明短期流动性来源",
        "提供关联公司支持函"
      ],
      "description": "流动比率低于 1.0，短期偿债缓冲不足"
    },
    {
      "id": "corp_rl_008",
      "name": "速动比率严重不足",
      "category": "financial",
      "feature_expr": "financial.quick_ratio",
      "operator": "<",
      "default_threshold": 0.5,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "速动比率低于 0.5，流动性风险显著"
    },
    {
      "id": "corp_rl_009",
      "name": "毛利率显著低于行业",
      "category": "financial",
      "feature_expr": "financial.gross_margin_gap",
      "operator": "<",
      "default_threshold": -0.1,
      "severity": "green",
      "can_waive": true,
      "waiver_conditions": [
        "说明毛利差异原因"
      ],
      "description": "毛利率低于行业基准 10 个百分点以上"
    },
    {
      "id": "corp_rl_010",
      "name": "营收大幅下滑",
      "category": "financial",
      "feature_expr": "financial.revenue_growth",
      "operator": "<",
      "default_threshold": -0.2,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "说明下滑原因及复苏计划",
        "追加担保"
      ],
      "description": "营业收入同比下滑超过 20%"
    },
    {
      "id": "corp_rl_011",
      "name": "行业处于政策收紧期",
      "category": "industry",
      "feature_expr": "industry.policy_sensitivity",
      "operator": ">=",
      "default_threshold": 0.8,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供政策合规证明"
      ],
      "description": "所在行业受政策管控力度较强"
    },
    {
      "id": "corp_rl_012",
      "name": "行业景气度持续低迷",
      "category": "industry",
      "feature_expr": "industry.prosperity_index",
      "operator": "<",
      "default_threshold": 40,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供行业细分赛道分析"
      ],
      "description": "行业景气指数持续低于 40"
    },
    {
      "id": "corp_rl_013",
      "name": "行业属于高风险黑名单",
      "category": "industry",
      "feature_expr": "industry.in_blacklist",
      "operator": "==",
      "default_threshold": 1,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "企业所属行业在总行风险黑名单内"
    },
    {
      "id": "corp_rl_014",
      "name": "客户集中度过高",
      "category": "industry",
      "feature_expr": "operational.customer_concentration",
      "operator": ">",
      "default_threshold": 0.5,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供多客户拓展计划"
      ],
      "description": "前五大客户营收占比超过 50%"
    },
    {
      "id": "corp_rl_015",
      "name": "供应链集中度过高",
      "category": "industry",
      "feature_expr": "operational.supplier_concentration",
      "operator": ">",
      "default_threshold": 0.6,
      "severity": "green",
      "can_waive": true,
      "waiver_conditions": [
        "披露核心供应商合作协议"
      ],
      "description": "前五大供应商占比超过 60%"
    },
    {
      "id": "corp_rl_016",
      "name": "企业成立年限不足",
      "category": "operational",
      "feature_expr": "operational.established_years",
      "operator": "<",
      "default_threshold": 2,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "核心团队行业经验证明"
      ],
      "description": "企业成立年限小于 2 年"
    },
    {
      "id": "corp_rl_017",
      "name": "员工规模过小",
      "category": "operational",
      "feature_expr": "operational.employee_count",
      "operator": "<",
      "default_threshold": 10,
      "severity": "green",
      "can_waive": true,
      "waiver_conditions": [
        "说明轻资产模式"
      ],
      "description": "员工人数低于 10 人"
    },
    {
      "id": "corp_rl_018",
      "name": "现金流覆盖率不足",
      "category": "operational",
      "feature_expr": "operational.cashflow_coverage",
      "operator": "<",
      "default_threshold": 1.0,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "追加还款来源证明"
      ],
      "description": "经营性现金流不足以覆盖新增授信年度还本付息"
    },
    {
      "id": "corp_rl_019",
      "name": "存在工商异常",
      "category": "operational",
      "feature_expr": "external.has_industrial_abnormal",
      "operator": "==",
      "default_threshold": 1,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "企业存在工商登记异常"
    },
    {
      "id": "corp_rl_020",
      "name": "存在司法诉讼",
      "category": "operational",
      "feature_expr": "external.litigation_count",
      "operator": ">",
      "default_threshold": 3,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供诉讼进展说明"
      ],
      "description": "未结诉讼超过 3 起"
    },
    {
      "id": "corp_rl_021",
      "name": "存在税务异常",
      "category": "operational",
      "feature_expr": "external.tax_abnormal",
      "operator": "==",
      "default_threshold": 1,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "企业存在税务异常记录"
    },
    {
      "id": "corp_rl_022",
      "name": "存在环保处罚",
      "category": "operational",
      "feature_expr": "external.env_penalty_count",
      "operator": ">",
      "default_threshold": 0,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "提供整改证明"
      ],
      "description": "近 24 个月存在环保行政处罚"
    },
    {
      "id": "corp_rl_023",
      "name": "抵押物覆盖率不足",
      "category": "guarantee",
      "feature_expr": "guarantee.coverage_ratio",
      "operator": "<",
      "default_threshold": 1.0,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "追加保证人",
        "引入反担保"
      ],
      "description": "抵押物估值不足以覆盖申请授信额度"
    },
    {
      "id": "corp_rl_024",
      "name": "无有效担保安排",
      "category": "guarantee",
      "feature_expr": "guarantee.has_any_collateral",
      "operator": "==",
      "default_threshold": 0,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "无任何抵押物或保证人"
    },
    {
      "id": "corp_rl_025",
      "name": "抵押物类型为高波动资产",
      "category": "guarantee",
      "feature_expr": "guarantee.collateral_is_volatile",
      "operator": "==",
      "default_threshold": 1,
      "severity": "green",
      "can_waive": true,
      "waiver_conditions": [
        "提高抵押率要求"
      ],
      "description": "抵押物为股权、应收账款等估值波动较大的资产"
    },
    {
      "id": "corp_rl_026",
      "name": "保证人为单一自然人且资产单薄",
      "category": "guarantee",
      "feature_expr": "guarantee.guarantor_strength_score",
      "operator": "<",
      "default_threshold": 50,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "引入第二保证人"
      ],
      "description": "保证人还款能力评分低于 50"
    },
    {
      "id": "corp_rl_027",
      "name": "实控人股权大比例质押",
      "category": "external",
      "feature_expr": "external.controller_pledge_ratio",
      "operator": ">",
      "default_threshold": 0.7,
      "severity": "yellow",
      "can_waive": true,
      "waiver_conditions": [
        "解除部分股权质押",
        "实控人提供资产说明"
      ],
      "description": "实际控制人股权质押比例超过 70%"
    },
    {
      "id": "corp_rl_028",
      "name": "历史授信逾期严重",
      "category": "external",
      "feature_expr": "external.serious_overdue_count",
      "operator": ">",
      "default_threshold": 0,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "存在 M3 及以上逾期历史"
    },
    {
      "id": "corp_rl_029",
      "name": "企业列入失信被执行人",
      "category": "external",
      "feature_expr": "external.in_dishonest_list",
      "operator": "==",
      "default_threshold": 1,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "企业或其实控人列入失信被执行人名单"
    },
    {
      "id": "corp_rl_030",
      "name": "存在反洗钱风险提示",
      "category": "external",
      "feature_expr": "external.aml_flag",
      "operator": "==",
      "default_threshold": 1,
      "severity": "red",
      "can_waive": false,
      "waiver_conditions": [],
      "description": "触发总行反洗钱黑名单或高风险国别交易"
    }
  ]
}
