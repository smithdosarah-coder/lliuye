{
  "name": "@liuye/tests-mock-sse",
  "version": "0.1.0",
  "private": true,
  "description": "W1 mock-test worker · mock SSE harness + contract spec + Playwright smoke + migration spec (老 v1.0 SSE · 7 event · heartbeat 15s · LEI replay)",
  "scripts": {
    "mock-sse:channel": "tsx mock-sse/channel.ts --port 8001 --fixture fixtures/channel_5candidates.json",
    "mock-sse:credit": "tsx mock-sse/credit.ts --port 8002 --fixture fixtures/credit_decision_PASS.json",
    "mock-sse:report": "tsx mock-sse/report.ts --port 8003 --fixture fixtures/report_v16_PARTIAL.json",
    "contract:schema": "tsx contract/schema-validate.spec.ts",
    "contract:payload": "tsx contract/payload-shape.spec.ts",
    "contract:all": "tsx contract/schema-validate.spec.ts && tsx contract/payload-shape.spec.ts",
    "smoke:home": "playwright test --config=e2e/playwright/playwright.config.ts e2e/playwright/home-silent.spec.ts --project=chromium",
    "smoke:demo": "playwright test --config=e2e/playwright/playwright.config.ts e2e/playwright/demo-path-step1-3.spec.ts --project=chromium",
    "smoke:all": "playwright test --config=e2e/playwright/playwright.config.ts --project=chromium",
    "migration:archive": "tsx migration/archive-storage.spec.ts",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^25.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
