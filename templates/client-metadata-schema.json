{
  "schema_version": "1.1.2",
  "layer": "client_metadata",
  "created": "2026-05-21",
  "updated": "2026-05-21",
  "description": "客户基础信息层 — 营业执照 / 工商档案 / 个人身份等冷数据 (rendering 用 deterministic REPLACE)",
  "source_of_truth": "营业执照 + 工商档案 (对公) · 身份证 + 居住证明 (对私)",
  "split_from": "placeholder-schema.json v1.1.2 (C 档第 1 步 · 68 字段 3 层拆分)",
  "changelog": [
    {
      "version": "1.1.2",
      "date": "2026-05-21",
      "phase": "C 档 第 1 步 · 3-layer split",
      "summary": "从 placeholder-schema.json v1.1.2 按 semantic 拆出 client_metadata 层 · 33 字段 · field 定义逐字保留 · 不改字段语义",
      "fields_count": 33
    }
  ],
  "syntax": {
    "marker": "{{KEY}}",
    "note": "全角空格不影响匹配; cross-run 字符串拆分需 placeholder 整段位于单一 run 内 (Phase 2 改 docx 时按 paragraph-level 整段替换保证)"
  },
  "scope_tag_legend": {
    "corporate": "仅对公 (legal entity 法人主体) 场景 · 经纬测绘 / 兴业资管 / 普惠 / 科创",
    "retail": "仅对私 (natural person 自然人主体) 场景 · 小微对私",
    "both": "对公 + 对私 共用 · v16_classifier 根据 scenario 路由"
  },
  "fields": [
