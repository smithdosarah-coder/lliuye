  "fallback_strategy": {
    "missing_value": "保留 {{KEY}} placeholder 原文",
    "rationale": "v16_generator REPLACE handler 在 client_metadata 无对应 key 时 不替换 + 写 pending_tag,符合刘野第二大脑 CLAUDE.md '幻觉零容忍 · 字段填不了标 未能自动填写' 规则。",
    "retail_specific": "对私 23 key 没有 alias_map fallback (worker 4 metadata.why_no_alias_fallback_for_retail_keys) · 调用方必须用 schema v1.1 完整 key 名传入 · 缺则保留原文 + pending"
  },
  "compatibility": {
    "merge_to_flat_dict": "consumer (v16_op_handlers.placeholder_replace) 仍消费 flat dict · resolve_client_metadata 把 3 层 merge 成单 dict 后注入 Materials.client_metadata",
    "backward_compat": "旧 metadata.json (单 flat dict 含全 68 key) 仍工作 · resolve_client_metadata 检测格式自动归一"
  }
