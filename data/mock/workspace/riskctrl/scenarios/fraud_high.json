    "description": "高风险欺诈拦截策略 v0.7 (草稿 · 反欺诈队列产能压测中)",
    "rules": [
      {
        "rule_id": "FRAUD-V07-R001",
        "name": "设备指纹聚类否决",
        "description": "device_fingerprint_cluster_size ≥ 5 → block",
        "conditions": [{"field": "device_fingerprint_cluster_size", "operator": ">=", "value": 5}],
        "action": "reject",
        "priority": 1
      },
      {
        "rule_id": "FRAUD-V07-R002",
        "name": "IP 地理位置失配",
        "description": "ip_geolocation_mismatch == true → block",
        "conditions": [{"field": "ip_geolocation_mismatch", "operator": "==", "value": true}],
        "action": "reject",
        "priority": 2
      },
      {
        "rule_id": "FRAUD-V07-R003",
        "name": "行为生物特征异常",
        "description": "behavioral_biometric_score ≤ 0.3 → block",
        "conditions": [{"field": "behavioral_biometric_score", "operator": "<=", "value": 0.3}],
        "action": "reject",
        "priority": 3
      },
      {
        "rule_id": "FRAUD-V07-R004",
        "name": "团伙网络高风险",
        "description": "social_graph_risk_score ≥ 0.7 AND shared_device_with_blacklist == true → block",
        "conditions": [
          {"field": "social_graph_risk_score", "operator": ">=", "value": 0.7},
          {"field": "shared_device_with_blacklist", "operator": "==", "value": true}
        ],
        "action": "reject",
        "priority": 4
      },
      {
        "rule_id": "FRAUD-V07-R005",
        "name": "申请速率异常 → 复核",
        "description": "application_velocity_24h ≥ 3 → review",
        "conditions": [{"field": "application_velocity_24h", "operator": ">=", "value": 3}],
        "action": "manual_review",
        "priority": 5
      },
      {
        "rule_id": "FRAUD-V07-R006",
        "name": "身份欺诈信号 → 复核",
        "description": "id_fraud_signal in [medium, high] → review",
        "conditions": [{"field": "id_fraud_signal", "operator": "in", "value": ["medium", "high"]}],
        "action": "manual_review",
        "priority": 6
      },
      {
        "rule_id": "FRAUD-V07-R007",
        "name": "金额异常分 → 复核",
        "description": "amount_anomaly_score ≥ 0.6 → review",
        "conditions": [{"field": "amount_anomaly_score", "operator": ">=", "value": 0.6}],
        "action": "manual_review",
        "priority": 7
      },
      {
        "rule_id": "FRAUD-V07-R008",
        "name": "默认通过 → 流入信用主链",
        "description": "其他 → pass · 流入信用主链复用 v1.5",
