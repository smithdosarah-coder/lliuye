        "action": "pass",
        "priority": 2
      },
      {
        "rule_id": "AML-V23-R003",
        "name": "高风险国家标志",
        "description": "high_risk_country_flag == false",
        "conditions": [{"field": "high_risk_country_flag", "operator": "==", "value": false}],
        "action": "pass",
        "priority": 3
      },
      {
        "rule_id": "AML-V23-R004",
        "name": "UBO 完整性",
        "description": "ubo_disclosure_complete == true",
        "conditions": [{"field": "ubo_disclosure_complete", "operator": "==", "value": true}],
        "action": "pass",
        "priority": 4
      },
      {
        "rule_id": "AML-V23-R005",
        "name": "注册资本下限",
        "description": "registered_capital ≥ 1,000,000",
        "conditions": [{"field": "registered_capital", "operator": ">=", "value": 1000000}],
        "action": "pass",
        "priority": 5
      },
      {
        "rule_id": "AML-V23-R006",
        "name": "地址核验分",
        "description": "address_verification_score ≥ 0.7",
        "conditions": [{"field": "address_verification_score", "operator": ">=", "value": 0.7}],
        "action": "pass",
        "priority": 6
      },
      {
        "rule_id": "AML-V23-R007",
        "name": "EDD 增强尽调档",
        "description": "PEP 中 OR UBO 缺 OR 地址 0.4-0.7 → review",
        "conditions": [
          {"field": "pep_status", "operator": "==", "value": "medium"}
        ],
        "action": "manual_review",
        "priority": 7
      },
      {
        "rule_id": "AML-V23-R008",
        "name": "兜底拒绝",
        "description": "其他 → block",
