        "rule_id": "AML-V23-R001",
        "name": "制裁名单一票否决",
        "description": "sanctions_list_match == false",
        "conditions": [{"field": "sanctions_list_match", "operator": "==", "value": false}],
        "action": "pass",
        "priority": 1
      },
